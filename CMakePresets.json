{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "renderer-debug",
      "displayName": "Renderer Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FASTJUNGLE_BUILD": "renderer"
      }
    },
    {
      "name": "renderer-release",
      "displayName": "Renderer Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FASTJUNGLE_BUILD": "renderer"
      }
    },
    {
      "name": "cooker-debug",
      "displayName": "Cooker Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FASTJUNGLE_BUILD": "cooker",
        "FASTJUNGLE_ENABLE_OPENEXR": "ON"
      }
    },
    {
      "name": "cooker-release",
      "displayName": "Cooker Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FASTJUNGLE_BUILD": "cooker",
        "FASTJUNGLE_ENABLE_OPENEXR": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "renderer-debug",
      "configurePreset": "renderer-debug"
    },
    {
      "name": "renderer-release",
      "configurePreset": "renderer-release"
    },
    {
      "name": "cooker-debug",
      "configurePreset": "cooker-debug"
    },
    {
      "name": "cooker-release",
      "configurePreset": "cooker-release"
    }
  ]
}
